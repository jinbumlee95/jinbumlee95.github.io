{"id":"2022-calculus-30","subject":"calculus","title":"미정 함수 대신 넓이의 재귀 관계를 시각화","summary":"증가함수 f와 역함수 g의 관계 g(2x)=2f(x), ∫1²f=5/4","answer":"143","result":"143","steps":[{"title":"대응점 사슬","formula":"f(1)=1\\Rightarrow g(2)=2\\Rightarrow f(2)=2\\Rightarrow f(4)=4\\Rightarrow f(8)=8","body":"함수 전체는 정해지지 않았다. 확실한 네 대응점만 표시한다.","model":{"lines":[{"points":[[0,0,0],[9,9,0]],"color":"#a8a29e","dashed":true}],"dots":[{"at":[1,1,0],"label":"(1,1)","color":"#d97706"},{"at":[2,2,0],"label":"(2,2)","color":"#d97706"},{"at":[4,4,0],"label":"(4,4)","color":"#d97706"},{"at":[8,8,0],"label":"(8,8)","color":"#d97706"}],"surfaces":[],"range":[0,9,0,9],"threeD":false,"metrics":[{"label":"회색 대각선","value":"대응점 기준선, f의 그래프 아님"}],"description":"함수 전체는 정해지지 않았다. 확실한 네 대응점만 표시한다."}},{"title":"적분을 세 구간으로 나누기","formula":"I_1=\\int_1^2f=5/4,\\ I_2=\\int_2^4f,\\ I_3=\\int_4^8f","body":"도형은 면적 수치를 표현하는 블록이다. 미정 함수의 그래프를 직선으로 가정하지 않는다.","model":{"lines":[],"dots":[{"at":[1.5,1.25,0],"label":"I₁=5/4","color":"#2563eb"}],"surfaces":[{"points":[[1,0,0],[2,0,0],[2,1.25,0],[1,1.25,0]],"color":"#2563eb","opacity":0.35}],"range":[0,9,0,6],"threeD":false,"metrics":[{"label":"블록 의미","value":"적분값만 표현"}],"description":"도형은 면적 수치를 표현하는 블록이다. 미정 함수의 그래프를 직선으로 가정하지 않는다."}},{"title":"역함수 적분과 두 배 확대","formula":"I_2+\\int_2^4g=4^2-2^2=12,\\quad\\int_2^4g(y)dy=4I_1=5","body":"가로축 치환 y=2x와 높이 2배가 함께 적용되어 넓이는 4배가 된다.","model":{"lines":[],"dots":[{"at":[1.5,1.25,0],"label":"I₁=5/4","color":"#2563eb"},{"at":[3,3.5,0],"label":"I₂=7","color":"#d97706"}],"surfaces":[{"points":[[1,0,0],[2,0,0],[2,1.25,0],[1,1.25,0]],"color":"#2563eb","opacity":0.35},{"points":[[2,0,0],[4,0,0],[4,3.5,0],[2,3.5,0]],"color":"#d97706","opacity":0.35}],"range":[0,9,0,6],"threeD":false,"metrics":[{"label":"I₂","value":"12−5=7"}],"description":"가로축 치환 y=2x와 높이 2배가 함께 적용되어 넓이는 4배가 된다."}},{"title":"다음 구간에도 같은 관계","formula":"I_3=8^2-4^2-4I_2=48-28=20","body":"알려진 면적 7을 이용하여 다음 구간의 면적 20을 구한다.","model":{"lines":[],"dots":[{"at":[1.5,1.25,0],"label":"I₁=5/4","color":"#2563eb"},{"at":[3,3.5,0],"label":"I₂=7","color":"#d97706"},{"at":[6,5,0],"label":"I₃=20","color":"#0f766e"}],"surfaces":[{"points":[[1,0,0],[2,0,0],[2,1.25,0],[1,1.25,0]],"color":"#2563eb","opacity":0.35},{"points":[[2,0,0],[4,0,0],[4,3.5,0],[2,3.5,0]],"color":"#d97706","opacity":0.35},{"points":[[4,0,0],[8,0,0],[8,5,0],[4,5,0]],"color":"#0f766e","opacity":0.35}],"range":[0,9,0,6],"threeD":false,"metrics":[{"label":"총 면적","value":"5/4+7+20=113/4"}],"description":"알려진 면적 7을 이용하여 다음 구간의 면적 20을 구한다."}},{"title":"부분적분으로 원하는 적분 계산","formula":"\\int_1^8xf'(x)dx=[xf(x)]_1^8-\\int_1^8f=63-\\frac{113}{4}=\\frac{139}{4}","body":"전체 함수식을 구하지 않아도 경계값과 세 구간의 면적으로 충분하다.","model":{"lines":[],"dots":[{"at":[0.5,63,0],"label":"경계항 63","color":"#d97706"},{"at":[1.5,28.25,0],"label":"빼는 넓이 113/4","color":"#d97706"},{"at":[2.5,34.75,0],"label":"결과 139/4","color":"#0f766e"}],"surfaces":[{"points":[[0.25,0,0],[0.75,0,0],[0.75,63,0],[0.25,63,0]],"color":"#0f766e","opacity":0.55},{"points":[[1.25,0,0],[1.75,0,0],[1.75,28.25,0],[1.25,28.25,0]],"color":"#0f766e","opacity":0.55},{"points":[[2.25,0,0],[2.75,0,0],[2.75,34.75,0],[2.25,34.75,0]],"color":"#0f766e","opacity":0.55}],"range":[0,3,0,65],"threeD":false,"metrics":[{"label":"p+q","value":"4+139=143"}],"description":"전체 함수식을 구하지 않아도 경계값과 세 구간의 면적으로 충분하다."}}],"checks":[{"label":"두 번째 면적","actual":7,"expected":7,"tolerance":1e-7},{"label":"세 번째 면적","actual":20,"expected":20,"tolerance":1e-7},{"label":"최종 적분","actual":34.75,"expected":34.75,"tolerance":1e-7}],"source":{"questionPage":12,"solutionPage":21},"verified":true}